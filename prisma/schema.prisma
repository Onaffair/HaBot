generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ========== 监听群组 ==========
model GroupListen {
  id      Int     @id @default(autoincrement())
  groupId String  @unique @map("group_id")
  enabled Boolean @default(true)

  @@map("group_listens")
}

// ========== 对话记忆 / 对话摘要 已移除：聊天记录不做保留 ==========

// ========== 用户黑名单 ==========
model UserBlacklist {
  id        Int      @id @default(autoincrement())
  qq        String   @unique // QQ号
  reason    String?          // 拉黑原因
  createdAt DateTime @default(now()) @map("created_at")

  @@map("user_blacklist")
}

// ========== 目录管理（managed_resources / resource_settings）与触发规则（command_rules）已移除 ==========
// 两者的能力全部由下方「流程画布」承载：一条规则 = 一张「触发 → 消息 → 输出」画布，
// 资源本身以文件系统路径直接引用（bot/utils/resourcePath），不再做数据库登记。
// 存量数据由 scripts/migrateManagedToCanvas.ts 在删表前迁移完成。

// ========== 流程画布 ==========
// 存储前端 vue-flow 画布：节点与连线以 JSON 数组字符串落库（与 keywords 字段同风格），
// 由后端负责序列化/反序列化；enabled 标记该流程是否允许底层执行。
model Canvas {
  id          Int      @id @default(autoincrement())
  name        String   @unique // 画布名称（唯一标识，可用于事件绑定）
  description String? // 画布描述
  enabled     Boolean  @default(true) // 是否启用
  nodes       String   @default("[]") // vue-flow 节点数组，JSON 字符串
  edges       String   @default("[]") // vue-flow 连线数组，JSON 字符串
  viewport    String? // 画布视口状态，JSON 字符串 { x, y, zoom }（可选，用于还原）
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("canvases")
}

// ========== 画布流转日志 ==========
// 规则引擎每完成一次画布流转写一行，供前端「画布日志」分页回溯：
// 命中了什么消息、在哪个群、是否发送成功，异常时 error 保存失败节点信息。
model CanvasFlowLog {
  id        Int      @id @default(autoincrement())
  canvasId  Int      @map("canvas_id") // 所属画布（canvases.id，不做外键约束，删画布时由服务层清理）
  groupId   String   @default("") @map("group_id") // 群号；私聊为空串
  message   String   @default("") // 触发流转的消息文本（纯文本段拼接）
  status    String   @default("success") // 'success' | 'error'（error=流转过程中有节点异常）
  error     String? // 异常摘要：失败节点与原因，多个以分号连接
  createdAt DateTime @default(now()) @map("created_at")

  @@index([canvasId, createdAt])
  @@map("canvas_flow_logs")
}

// ========== AI 人格提示词 ==========
// 对话机器人（aiChat）的系统人格：name 唯一，prompt 为提示词全文；
// isActive 标记当前生效人格，全表最多一条为 true（互斥由服务层保证）。
model AiPersona {
  id        Int      @id @default(autoincrement())
  name      String   @unique // 人格名称
  prompt    String // 提示词（系统人格全文）
  isActive  Boolean  @default(false) @map("is_active") // 是否为当前生效人格
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_personas")
}

// ========== 用户数字画像 ==========
// 一次 AI 对话循环结束后，另起一个请求把会话内容交给 AI 总结，
// 生成针对某个 QQ 用户的画像（性格/兴趣/说话风格/关注话题/关键事实等），
// 供后续「记忆」功能使用（记忆功能本身暂不实现）。按 qq 唯一，upsert 覆盖。
model UserProfile {
  id        Int      @id @default(autoincrement())
  qq        String   @unique // 用户 QQ 号
  nickname  String   @default("") // 最近一次见到的昵称/群名片
  profile   String   @default("") // AI 生成的数字画像总结
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

// ========== 系统配置（键值对，由前端管理页面编辑） ==========
// 替代 .env 中除 DATABASE_URL 外的全部可配置项；
// requiresRestart=true 时保存后自动重启 Bot 连接。
model SystemConfig {
  id              Int      @id @default(autoincrement())
  key             String   @unique
  value           String   @default("")
  category        String                    // websocket | http | bot | resource | ai | backend
  label           String                    // 前端展示名
  type            String   @default("string") // string | number | password
  description     String?                   // 说明/placeholder
  requiresRestart Boolean  @default(false)  // 修改后需重启 Bot
  sortOrder       Int      @default(0)      // 前端展示排序
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}