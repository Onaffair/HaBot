{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/bot/*"],
      "@config": ["src/bot.config.ts"],
      "@utils/*": ["src/utils/*"]
    },
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src", "src/bot/api"],
  "exclude": ["node_modules", "dist","test.js"]
}
