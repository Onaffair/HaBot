# ==========================================
# HaBot 配置文件示例
# ==========================================
# 复制为 .env 后按需修改。
# 此处仅保留进程级基础设施参数：
#   DATABASE_URL  由 Prisma 在客户端构造时读取，无法运行期热切换
#   BACKEND_PORT  管理后台监听端口，改错会导致界面失联
# 其余配置（OneBot WS/HTTP 连接、Bot 身份、资源路径、AI 平台与全局代理）
# 存放在数据库 system_configs 表，通过「管理后台 → 系统配置」页面维护。
# 若希望首次启动以指定值作为种子导入，可解开下方“可选种子”段落填写，
# 每个 key 仅在数据库中没有对应记录时导入一次，之后一律以数据库为准。
# ==========================================

# === Database ===
DATABASE_URL=file:./dev.db

# === Backend ===
BACKEND_PORT=3100

# === 可选：首次启动种子 ===
# WS_URL=ws://127.0.0.1:3001
# WS_TOKEN=
# HTTP_BASE_URL=http://127.0.0.1:3000
# HTTP_TOKEN=
# ME=
# RESOURCE_PATH=src/resources
# outputDir=src/output
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
# ZHIPUAI_API_KEY=
# ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/images/generations
# FISHAUDIO_API_KEY=
# FISHAUDIO_BASE_URL=https://api.fish.audio/v1/tts
# AI_PROXY_HOST=
# AI_PROXY_PORT=7897
