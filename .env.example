# ==========================================
# HaBot 配置文件
# ==========================================
# 基础设施连接参数和密钥统一在 .env 中管理
# 运行时可变的应用数据（群组、资源等）仍在数据库中
# ==========================================

# === Database ===
DATABASE_URL=file:./dev.db
# === WebSocket (OneBot 协议连接) ===
WS_URL=ws://127.0.0.1:3001
WS_TOKEN='d-*>n@2f}$]X-DOe'

# === HTTP API (OneBot HTTP 接口) ===
HTTP_BASE_URL=http://127.0.0.1:3000
HTTP_TOKEN='gPp<&@#FLB&;H1#<'

# === Bot 身份 ===
ME=2934785512

# === 资源路径 ===
RESOURCE_PATH=src/resources

# === OSS (阿里云对象存储) ===
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# === AI - OpenAI/SiliconFlow (LLM 对话) ===
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1/chat/completions

# === AI - 智谱 (图像生成) ===
ZHIPUAI_API_KEY=
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/images/generations

# === AI - Fish Audio (TTS 语音合成) ===
FISHAUDIO_API_KEY=
FISHAUDIO_BASE_URL=https://api.fish.audio/v1/tts
FISHAUDIO_PROXY_HOST=127.0.0.1
FISHAUDIO_PROXY_PORT=7897


outputDir=src/output
