{
  "name": "habot",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "dev:backend": "ts-node -r tsconfig-paths/register src/back/index.ts",
    "dev:frontend": "npm run dev --prefix src/front",
    "dev:all": "concurrently -k -n server,frontend -c cyan,magenta \"npm:dev\" \"npm:dev:frontend\"",
    "migrate": "ts-node -r tsconfig-paths/register scripts/migrateEnvToDb.ts",
    "migrate:trigger": "ts-node -r tsconfig-paths/register scripts/migrateTriggerKeywords.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node -r module-alias/register dist/index.js"
  },
  "author": "Onaffair",
  "license": "ISC",
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "axios": "^1.13.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "md5": "^2.3.0",
    "module-alias": "^2.2.3",
    "multer": "^2.0.0",
    "playright": "^0.0.22",
    "prisma": "^5.22.0",
    "ws": "^8.18.3"
  },
  "_moduleAliases": {
    "@": "dist/bot",
    "@config": "dist/bot.config.js",
    "@utils": "dist/bot/utils",
    "@ai": "dist/ai"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.12",
    "concurrently": "^10.0.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
